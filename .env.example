# ============ Bybit credentials ============
# Create a V3 API key with Read-Write + Contract Trading permission.
# DO NOT enable withdrawal and DO NOT enable IP whitelist (Railway egress IPs are dynamic).
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Set true to use Bybit testnet (keys from https://testnet.bybit.com) instead of live.
BYBIT_TESTNET=false

# ============ Webhook auth ============
# Shared secret that EVERY TradingView alert must include as "secret" in its JSON body.
WEBHOOK_SECRET=

# ============ Safety guardrails ============
# Master kill switch. Set false to make the bot accept-and-log alerts but never place orders.
TRADING_ENABLED=true
# Comma-separated list of symbols the bot is allowed to trade.
ALLOWED_SYMBOLS=BTCUSDT
# Hard safety cap: reject any single order larger than this quantity.
# (90%-of-balance sizing on a large account can exceed 1 BTC — raise/tighten to taste.)
MAX_QTY_PER_ORDER=100.0
# Hard safety cap: reject any order whose qty * current price exceeds this notional (USD).
MAX_NOTIONAL_USD=100000.0
# Reject alerts requesting more leverage than this. (Your strategy: 5x.)
MAX_LEVERAGE=5
# Fraction of wallet balance used as margin per trade when an alert omits "qty".
# 0.90 = 90% of total margin in the trade.
MARGIN_USAGE_PERCENT=0.90

# ============ Defaults when an alert omits a field ============
DEFAULT_LEVERAGE=5
# Fallback take-profit as a decimal (0.05 = 5%). 0 = do not attach (you send "tp" in the alert).
DEFAULT_TP_PERCENT=0
# Fallback stop-loss as a decimal. 0.04 = 4% price move = 20% of margin at 5x leverage.
DEFAULT_SL_PERCENT=0.04

# ============ Behaviour ============
# Suppress duplicate alerts for the same signal within this many seconds.
COOLDOWN_SECONDS=5
LOG_LEVEL=INFO
# Railway injects PORT automatically; you usually don't need to set it.
PORT=8000
