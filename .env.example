# ============ Bybit credentials ============
# Create a V3 API key with Read-Write + Contract Trading permission.
# DO NOT enable withdrawal and DO NOT enable IP whitelist (Railway egress IPs are dynamic).
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Set true to use Bybit testnet (keys from https://testnet.bybit.com) instead of live.
BYBIT_TESTNET=false

# ============ Webhook auth ============
# Shared secret that EVERY TradingView alert must include as "secret" in its JSON body.
# Also the default password for the /dashboard login (see DASHBOARD_PASSWORD below).
WEBHOOK_SECRET=

# ============ Dashboard ============
# Optional. If set, this is the password for the /dashboard login page.
# If left empty, WEBHOOK_SECRET is used.
DASHBOARD_PASSWORD=
# Optional path to a JSON file that persists dashboard-tuned settings (leverage,
# SL %, margin %, pairs, on/off) so they survive restarts. On Railway, point this
# at a persistent volume mount, e.g. TKKBOT_CONFIG_PATH=/data/tkkbot_config.json.
# Leave empty for in-memory settings that reset to these env defaults on restart.
TKKBOT_CONFIG_PATH=
# Optional. The public origin the bot is reached at, used to show a copy-paste
# webhook URL on the dashboard, e.g. https://tkkbot-production.up.railway.app
# Only needed if the request-derived URL comes out wrong (it looks like
# http://0.0.0.0:8000/ when the proxy's forwarded headers aren't trusted).
PUBLIC_BASE_URL=

# ============ Safety guardrails ============
# Master kill switch. Set false to make the bot accept-and-log alerts but never place orders.
TRADING_ENABLED=true
# Comma-separated list of symbols the bot may trade. The dashboard can add more.
ALLOWED_SYMBOLS=BTCUSDT
# Hard safety cap: reject any single order larger than this quantity.
# (90%-of-balance sizing on a large account can exceed 1 BTC — raise/tighten to taste.)
MAX_QTY_PER_ORDER=100.0
# Hard safety cap: reject any order whose qty * current price exceeds this notional (USD).
MAX_NOTIONAL_USD=100000.0
# Highest leverage the dashboard will allow (the bot uses the dashboard's value,
# not the alert's). Raise to e.g. 100 on Railway if you want to go above 5x.
MAX_LEVERAGE=5
# Fraction of wallet balance used as margin per trade when an alert omits "qty".
# 0.90 = 90% of total margin in the trade.
MARGIN_USAGE_PERCENT=0.90

# ============ Defaults when an alert omits a field ============
DEFAULT_LEVERAGE=5
# Fallback take-profit as a decimal (0.05 = 5%). 0 = do not attach (you send "tp" in the alert).
DEFAULT_TP_PERCENT=0
# Fallback stop-loss as a decimal. 0.04 = 4% price move = 20% of margin at 5x leverage.
# Used to seed the dashboard; the dashboard then becomes the source of truth.
DEFAULT_SL_PERCENT=0.04

# ============ Behaviour ============
# Suppress duplicate alerts for the same signal within this many seconds.
COOLDOWN_SECONDS=5
LOG_LEVEL=INFO
# Railway injects PORT automatically; you usually don't need to set it.
PORT=8000

# ============ Market scanner (informational, never trades) ============
# Scans four times a day and stores a ranked Top 10 (5 crypto + 5 stocks).
# These results are NOT wired into order execution — TKKBOT's trading path
# ignores them. Required keys are checked at the start of every scan.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

COINGECKO_API_KEY=
CMC_API_KEY=
# One stock provider is enough. Twelve Data is primary; Finnhub is the swappable
# alternative (and also supplies company headlines).
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
# Optional news (either or both).
NEWS_API_KEY=
CRYPTOPANIC_API_KEY=

# Optional Telegram delivery of the ranked list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server-side scheduler. Off by default: a Railway cron service running
# `python -m scanner.run` is preferred (see README).
SCAN_SCHEDULER_ENABLED=false
SCAN_TIMES_UTC=00:00,06:00,12:00,18:00
# Shared key for GET /opportunities/latest, /history and POST /scan (X-API-Key).
# Empty = those routes fail closed with 503.
OPPORTUNITIES_API_KEY=
# Reserved stub. No code path reads this into the trading logic: scan results
# are informational and never place orders.
OPPORTUNITIES_FEED_TO_BOT=false

# Storage. sqlite:// URLs are supported; on Railway point these at the volume
# (e.g. /data). Empty SCAN_DB_PATH + empty DATABASE_URL = JSON files in the
# data directory (/data on Railway, ./data locally).
DATABASE_URL=
SCAN_DB_PATH=
SCAN_DATA_DIR=

# Universe floors.
MIN_CRYPTO_MCAP_USD=100000000
MIN_CRYPTO_VOLUME_USD=10000000
MIN_STOCK_AVG_VOLUME=1000000

# Optional scoring-file overrides (defaults ship inside the scanner package).
TECH_UNIVERSE_PATH=
SCORING_WEIGHTS_PATH=
